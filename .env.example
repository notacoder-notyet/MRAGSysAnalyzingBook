# Пример файла с ключами. Скопируйте в .env и впишите свои значения:
#   cp .env.example .env
# .env уже в .gitignore — в репозиторий не попадёт.

# --- OpenRouter (рекомендуется: есть бесплатные модели) ---
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- OpenAI (платно, нужен только если не используете OpenRouter) ---
OPENAI_API_KEY=

# --- Ollama (полностью локально, ключ не нужен) ---
# OLLAMA_BASE_URL=http://localhost:11434